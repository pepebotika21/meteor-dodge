pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
function _init()
	estado = 0 -- 0: menu, 1: juego, 2: game over
	reset_juego() -- inicializa todas las variables
	music(0)
	t_menu = 0
end

function reset_juego()
	-- jugador
	px = 60
	py = 110
	
	-- tablas
	bala = {}
	met = {}
	
	-- contadores
	timer = 0
	velm = 0.2
	cont = 0
	puntos = 0
	i = 120
end	

function _update()
	---------------------------------------
	-- 0. menu
	---------------------------------------
	if estado == 0 then
		t_menu = t_menu + 1
		if btnp(4) or btnp(5) then
			reset_juego()
			music(-1)
			estado = 1
			t_menu = 0
		end
		
	---------------------------------------
	-- 1. juego
	---------------------------------------
	elseif estado == 1 then
		-- actualizar contadores solo durante el juego
		timer = timer + 1
		cont = cont + 1
		

		-- movimiento
		if btn(0) then px = px - 2 end
		if btn(1) then px = px + 2 end
		if px < 0 then px = 0 end
		if px > 120 then px = 120 end
		
		-- disparar
		if btnp(4) then
			add(bala, {x = px + 3, y = py})
			sfx(0)
		end

		-- mover balas
		for b in all(bala) do
			b.y = b.y - 4
			if b.y < -4 then
				del(bala, b)
			end
		end
		
		-- generar meteoritos
		if timer > i then
			add(met,
					 {x = rnd(120),
					  y = -8,
					  v = 0.4 + rnd(0.7),
					  vx = -0.5+rnd(1)})
			timer = 0
			i = max(25, i - 5)
		end

		-- aceleracion progresiva
		--if cont == 200 then
			--velm = velm + 0.1
			--cont = 0
		--end 

		-- mover meteoritos y perder si llegan abajo
		for m in all(met) do
			m.y = m.y + m.v
			m.x = m.x + m.vx
			m.x = mid(0, m.x, 120) -- evita que se salga
			
			if m.y > 120 then
				sfx(1)     -- sonido de derrota
				estado = 2 -- cambia a pantalla de game over
			end
		end
		
		-- colisiones bala - meteorito
		for b in all(bala) do
			for m in all(met) do
				if b.x + 8 > m.x and 
				   b.x < m.x + 8 and 
				   b.y + 8 > m.y and 
				   b.y < m.y + 8 then
					
					del(met, m)
					del(bala, b) 
					sfx(1)
					puntos = puntos + 1
					break        
				end
			end
		end
		
	---------------------------------------
	-- 2. game over
	---------------------------------------
	elseif estado == 2 then
		if btnp(4) or btnp(5) then
			estado = 0 -- volver al menu
		end
	end
end

function _draw()
	cls(1) -- limpia la pantalla en cada fotograma
	
	---------------------------------------
	-- 0. dibuja menu
	---------------------------------------
	if estado == 0 then
		if t_menu > 10 then
			local y_titulo = mid(35, -10 + (t_menu - 10) * 2, 35)
			-- sombra negra (color 0)
			print("m e t e o r   d o d g e", 19, y_titulo + 1, 0)
			-- texto principal rojo (color 8)
			print("m e t e o r   d o d g e", 18, y_titulo, 8)
		end
		
		if t_menu > 45 then
			-- sombra negra (color 0)
			print("pulsa z o c para jugar", 21, 81, 0)
			-- texto parpadeante
			local col_texto = (flr(time() * 2) % 2 == 0) and 7 or 6
			print("pulsa z o c para jugar", 20, 80, col_texto)
		end

	---------------------------------------
	-- 1. dibuja juego
	---------------------------------------
	elseif estado == 1 then
		spr(1, px, py)
		for b in all(bala) do spr(2, b.x, b.y) end
		for m in all(met) do spr(3, m.x, m.y) end
		print("pts:"..puntos, 96, 2, 7)

	---------------------------------------
	-- 2. dibuja game over
	---------------------------------------
	elseif estado == 2 then
		print("game over", 46, 40, 8)
		print("puntos: "..puntos, 44, 60, 7)
		print("pulsa z o c para inicio", 16, 85, 6)
	end
end
